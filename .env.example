# Rename this file to ".env" and paste your bot token after the = sign
DISCORD_TOKEN=

# Optional tweaks
TTS_VOICE=female
TTS_RATE=+50%
TTS_PITCH=+15Hz
READ_NAME=false
MAX_CHARS=300

# Auto-join: someone in a voice channel types in that channel's chat -> the bot joins
AUTO_JOIN=true
# Optional: a normal text channel that can also summon the bot to the typer's voice
# channel (right-click channel > Copy Channel ID). Empty = voice channel chat only.
READ_CHANNEL_ID=

# Limits for each member's own /myvoice settings (speed in x, pitch in Hz)
SPEED_MIN=1.0
SPEED_MAX=2.0
PITCH_MIN=-20
PITCH_MAX=40

# Free MongoDB Atlas (M0) connection string so /myvoice and /voice settings are never lost
# (see CLOUD_SETUP.md step 5). SECRET like the token: contains the database password.
MONGODB_URI=

# Optional: Google Cloud Text-to-Speech as the first-choice voice, ONLY within its free
# monthly quota (see CLOUD_SETUP.md step 6). SECRET like the token.
# The bot counts characters itself and switches to the free voices at the limit.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_MONTHLY_LIMIT=800000
GOOGLE_TTS_FEMALE=th-TH-Chirp3-HD-Kore
GOOGLE_TTS_MALE=th-TH-Chirp3-HD-Charon
